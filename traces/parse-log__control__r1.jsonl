"content":"import re\n\n# 시각, 레벨, [모듈], 메시지 순서\nLINE_RE = re.compile(r\"^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})\\s+ERROR\\s+\\[([^\\]]+)\\]\\s+(.*)$\")\n\n\ndef parse_errors(path):\n    # 기본 인코딩에 기대지 않고 UTF-8로 읽는다\n    rows = []\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            m = LINE_RE.match(line.rstrip(\"\\r\\n\"))\n            if m:\n                rows.append(m.groups())\n    return rows\n\n\ndef build_table(rows):\n    lines = [\"| 시각 | 모듈 | 메시지 |\", \"| --- | --- | --- |\"]\n    for time, module, message in rows:\n        lines.append(f\"| {time} | {module} | {message} |\")\n    return \"\\n\".join(lines) + \"\\n\"\n\n\ndef main():\n    rows = parse_errors(\"sample.log\")\n    # 쓰기도 UTF-8로 고정\n    with open(\"errors.md\", \"w\", encoding=\"utf-8\", newline=\"\\n\") as f:\n        f.write(build_table(rows))\n\n\nif __name__ == \"__main__\":\n    main()\n"}}}
